# UniCloud Environment Configuration Template
# Copy this file to .env and fill in your values

# ===========================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# ===========================================

# Database Configuration
DB_PASSWORD=your_secure_db_password
REDIS_PASSWORD=your_secure_redis_password

# JWT Configuration
JWT_SECRET=your-very-secure-256-bit-secret-key-here
JWT_EXPIRATION=86400

# ===========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ===========================================

# Production Database
PROD_DB_USER=prod_unicloud_user
PROD_DB_PASSWORD=your_very_secure_production_db_password

# Production Redis
PROD_REDIS_PASSWORD=your_very_secure_production_redis_password

# Production JWT
PROD_JWT_SECRET=your-production-256-bit-secret-key-here

# ===========================================
# OAUTH CREDENTIALS
# ===========================================

# Google Drive API
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
PROD_GOOGLE_CLIENT_ID=your_production_google_client_id
PROD_GOOGLE_CLIENT_SECRET=your_production_google_client_secret

# Microsoft OneDrive API
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
PROD_MICROSOFT_CLIENT_ID=your_production_microsoft_client_id
PROD_MICROSOFT_CLIENT_SECRET=your_production_microsoft_client_secret

# iCloud API
ICLOUD_CLIENT_ID=your_icloud_client_id
ICLOUD_CLIENT_SECRET=your_icloud_client_secret
PROD_ICLOUD_CLIENT_ID=your_production_icloud_client_id
PROD_ICLOUD_CLIENT_SECRET=your_production_icloud_client_secret

# ===========================================
# SPRING PROFILES
# ===========================================

# Available profiles: development, test, production
SPRING_PROFILE=development

# ===========================================
# MONITORING & LOGGING (Production)
# ===========================================

# Application monitoring
MONITORING_ENABLED=true
METRICS_EXPORT_PROMETHEUS=true

# Log levels (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_UNICLOUD=INFO

# ===========================================
# SECURITY SETTINGS
# ===========================================

# SSL/TLS Configuration
SSL_ENABLED=true
SSL_KEY_STORE=/etc/ssl/keystore.p12
SSL_KEY_STORE_PASSWORD=your_keystore_password

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# ===========================================
# EXTERNAL SERVICES
# ===========================================

# Email service (for notifications)
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# File storage limits (in bytes)
MAX_FILE_SIZE=104857600  # 100MB
MAX_REQUEST_SIZE=104857600

# ===========================================
# PERFORMANCE TUNING
# ===========================================

# Database connection pool
DB_POOL_SIZE=20
DB_POOL_MAX_IDLE=10
DB_POOL_MIN_IDLE=5

# Redis connection pool
REDIS_POOL_MAX_TOTAL=20
REDIS_POOL_MAX_IDLE=10
REDIS_POOL_MIN_IDLE=5

# ===========================================
# BACKUP & MAINTENANCE
# ===========================================

# Database backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Health check endpoints
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30